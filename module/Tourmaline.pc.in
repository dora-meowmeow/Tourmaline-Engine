prefix=@CMAKE_INSTALL_PREFIX@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@

Name: @PROJECT_NAME@
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Requires: glfw3, glx
Cflags: -std=c++@CMAKE_CXX_STANDARD@ -I${includedir}
Libs: -L${libdir} -Wl,-rpath,${libdir} -lTourmaline -lMagnumGlfwApplication -lMagnum -lMagnumGL -lMagnumShaders -lMagnumTrade -lMagnumMeshTools -lCorradeUtility -lCorradePluginManager

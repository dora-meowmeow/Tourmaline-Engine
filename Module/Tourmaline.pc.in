prefix=@CMAKE_INSTALL_PREFIX@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@

Name: @PROJECT_NAME@
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Requires.private: glfw3, glx
Cflags: -std=c++23 -Wl,--disable-new-dtags -Wl,-rpath,${libdir} -I${includedir}
Libs: -L${libdir} -lTourmaline -lMagnumGlfwApplication -lMagnum -lMagnumGL -lMagnumShaders -lGLX -lglfw -lCorradeUtility -lCorradePluginManager
